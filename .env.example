# Backend configuration for DataVizard
# Copy to .env and fill in your own key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Leave unset to use the built-in model fallback chain in
# backend/main.py (tries several current models in order so the app keeps
# working when Google retires/restricts one). Only set this if you need to
# pin a specific model - and note that pinning means you lose the fallback
# safety net if that exact model later 404s.
# GEMINI_MODEL=gemini-3.8-flash
